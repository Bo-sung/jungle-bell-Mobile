<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="워시타워 소스 연결"
            android:textColor="@color/bell_widget_title"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:lineSpacingExtra="3dp"
            android:text="세탁실 게시 QR을 폰 카메라로 스캔하면 이 화면이 열립니다.\nQR에는 모니터링 사이트 주소가 담겨 있고, 앱은 이 주소에 직접 접속해 위젯을 갱신합니다(서버 경유 없음). 주소가 바뀌면 세탁실에서 다시 스캔하세요."
            android:textColor="@color/bell_widget_secondary"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="소스 주소"
            android:textColor="@color/bell_widget_title"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etLaundrySourceUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:hint="https://….trycloudflare.com  또는  …/api/status"
            android:importantForAutofill="no"
            android:inputType="textUri"
            android:maxLines="3"
            android:textColor="@color/bell_widget_body"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvLaundrySourceStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="2dp"
            android:textColor="@color/bell_widget_secondary"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnLaundrySourceSave"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="검증 후 저장" />

            <Button
                android:id="@+id/btnLaundrySourceClear"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="연결 해제" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:lineSpacingExtra="3dp"
            android:text="QR 만들기: 아래 형식을 QR로 인코딩하면 카메라 스캔만으로 이 화면이 열립니다.\njunglebell://laundry-source?url={인코딩된 주소}\n\n저장된 주소는 이 기기에만 저장되고 서버·저장소로 전송되지 않습니다."
            android:textColor="@color/bell_widget_secondary"
            android:textSize="11sp" />
    </LinearLayout>
</ScrollView>
